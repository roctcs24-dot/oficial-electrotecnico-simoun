  "consecuencias": {
    "disparo_magnetico": { "titulo": "Disparo magnético del guardamotor", "texto": "La corriente superó el umbral magnético: hubo un cortocircuito o una corriente muy alta aguas abajo, como la de un motor 254Δ/440Y conectado en delta a 440 V. Abra el guardamotor, corrija la causa y mida el aislamiento antes de volver a cerrar. Tras un disparo, lleve el mando a apagado antes de cerrar." },
    "disparo_termico": { "titulo": "Disparo térmico del guardamotor", "texto": "La corriente estuvo por encima del ajuste durante demasiado tiempo. Compruebe la carga, la conexión del motor y que el ajuste coincida con la corriente de la placa. No suba el ajuste para evitar el disparo." },
    "disparo_rele_termico": { "titulo": "Disparo del relé térmico", "texto": "La sobrecarga fue suficiente para cambiar 95-96 y 97-98. Revise la conexión estrella o delta según la placa, la carga y las tres fases. El relé no corta la potencia: si 95-96 no está en serie con la bobina, el motor sigue conectado." },
    "disparo_barras": { "titulo": "Disparo del interruptor de barras", "texto": "Un cortocircuito sin protección cercana hizo disparar el interruptor aguas arriba. A bordo, esto podría dejar sin servicio a muchos otros equipos. Toda salida debe tener su propia protección. Corrija el cableado antes de rearmar." },
    "arco_contactos_soldados": { "titulo": "Arco: contactos soldados", "texto": "La corriente de cortocircuito soldó los polos del contactor, que ya no abrirá aunque su bobina quede sin tensión. Cambie el repuesto. Revise por qué se produjo el cortocircuito: dos contactores que nunca deben cerrar a la vez necesitan enclavamiento." },
    "bobina_quemada": { "titulo": "Bobina quemada", "texto": "La bobina recibió mucha más tensión que la nominal. Compruebe la etiqueta de la bobina y la tensión de mando antes de conectar. Cambie el repuesto." },
    "motor_quemado": { "titulo": "Motor quemado", "texto": "El devanado superó la temperatura admisible. Las causas habituales son una conexión incorrecta, como un motor 254Δ/440Y en delta a 440 V, o la falta de protección. Cambie el repuesto y corrija la causa." },
    "fusible_fundido": { "titulo": "Fusible fundido", "texto": "La corriente del circuito de mando superó la capacidad del fusible. Busque el cortocircuito o la sobrecarga antes de sustituirlo, y use siempre uno del mismo valor." },
    "lampara_quemada": { "titulo": "Luz piloto quemada", "texto": "La lámpara recibió demasiada tensión. Compruebe que su tensión nominal coincida con la del circuito de mando." },
    "vibracion_mando": { "titulo": "Vibración del contactor", "texto": "La bobina cierra y suelta sin parar, porque se alimenta a través de un contacto que ella misma abre. Revise el mando: el contacto de retención 13-14 es NA y va en paralelo con la marcha." },
    "multimetro_destruido": { "titulo": "Multímetro destruido", "texto": "Midió resistencia en un circuito con tensión. El óhmetro inyecta su propia corriente y no admite tensión externa. A bordo esto puede causar un arco en sus manos. Mida resistencia solo con el circuito aislado y la ausencia de tensión verificada." },
    "fusible_multimetro": { "titulo": "Fusible del multímetro fundido", "texto": "La entrada de corriente tiene una resistencia casi nula. En paralelo con una fuente equivale a un cortocircuito. La corriente se mide en serie, y en potencia es mejor usar la pinza." },
    "megohmetro_destruido": { "titulo": "Megóhmetro destruido", "texto": "Lo aplicó a un circuito con tensión. Aísle, bloquee y verifique la ausencia de tensión antes de medir el aislamiento." }
  }
}
